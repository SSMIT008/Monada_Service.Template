<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageId>Monada.Service.Template</PackageId>
    <Title>Clean Architecture Project Template</Title>
    <Authors>Mr. SMIT</Authors>
    <Description>Clean Architecture template for microservices with API, Application, Domain and Infrastructure layers</Description>
    <PackageTags>dotnet-new;templates;cleanarchitecture;webapi;microservice</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <RepositoryUrl>https://github.com/SSMIT008/Monada_Service.Template</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="working\content\**" Exclude="working\content\**\bin\**;working\content\**\obj\**" />
    <None Include="readme.md" Pack="true" PackagePath="\" />
    <Compile Remove="**\*" />
  </ItemGroup>
</Project>